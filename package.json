{
  "name": "whatsapp-receptionist",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Open-source AI receptionist for WhatsApp. Books real appointments, transcribes voice messages, integrates with Google Calendar and Stripe. Multi-tenant SaaS starter kit. Crafted in Italy with GDPR built-in.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiberius/whatsapp-receptionist.git"
  },
  "homepage": "https://github.com/Hiberius/whatsapp-receptionist#readme",
  "bugs": {
    "url": "https://github.com/Hiberius/whatsapp-receptionist/issues"
  },
  "author": {
    "name": "Christian Calabrò",
    "url": "https://github.com/Hiberius"
  },
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "ai",
    "receptionist",
    "chatbot",
    "saas-starter",
    "nextjs",
    "supabase",
    "anthropic",
    "claude",
    "stripe",
    "elevenlabs",
    "google-calendar",
    "gdpr",
    "italy",
    "multi-tenant",
    "open-source",
    "self-hosted",
    "appointments",
    "booking"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=60",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:lint": "node scripts/check-rls-migration.mjs",
    "security:secrets": "gitleaks detect --source . --verbose",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run db:lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.1",
    "@elevenlabs/elevenlabs-js": "^2.67.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "next": "15.5.28",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^20.4.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "ws": "^8.21.1",
    "js-yaml": "^4.3.0",
    "vite": "^7.1.13"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
